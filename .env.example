# Prefer npm run setup:local to generate random local credentials.
# Never commit .env or expose signing/database credentials in VITE_ variables.
NODE_ENV=development
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=2567
CLIENT_ORIGIN=http://localhost:5173
VITE_GAME_SERVER_URL=ws://localhost:2567
GUEST_SESSION_SIGNING_SECRET=replace-with-a-long-random-secret
GUEST_SESSION_TTL_SECONDS=3600
ROOM_MAX_PLAYERS=150
COUNTDOWN_SECONDS=5
RECONNECT_SECONDS=25
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://icewater:replace-with-local-password@localhost:5432/icewater
# Use a separate disposable test database:
# TEST_DATABASE_URL=postgresql://icewater:replace-with-local-password@localhost:5432/icewater_test
# Optional server-only override; full coverage through 150 is required:
# ICE_COUNT_BRACKETS=[{"maxPlayers":10,"icePlayers":1},{"maxPlayers":20,"icePlayers":2},{"maxPlayers":35,"icePlayers":3},{"maxPlayers":50,"icePlayers":5},{"maxPlayers":75,"icePlayers":7},{"maxPlayers":100,"icePlayers":10},{"maxPlayers":125,"icePlayers":12},{"maxPlayers":150,"icePlayers":15}]
