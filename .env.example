# Copy this file to .env for local development.
# Never add real credentials here or commit your .env file.

# Client-visible values: anything prefixed with VITE_ is public in the browser.
VITE_GAME_SERVER_URL=ws://localhost:2567

# Server
NODE_ENV=development
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=2567
CLIENT_ORIGIN=http://localhost:5173

# Replace with a long random value in every non-test environment.
GUEST_SESSION_SIGNING_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://icewater:replace-with-local-password@localhost:5432/icewater

# Optional: leave unused until multi-process matchmaking or presence is implemented.
# REDIS_URL=redis://localhost:6379

# Optional monitoring; keep disabled for local development unless needed.
# SENTRY_DSN=
# VITE_SENTRY_DSN=

